<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

    <!-- Hardware Interface: describes what hardware ros2_control is talking to
         and which interfaces (command/state) it exposes per joint.
         type="system" = a full interface with multiple joints, read+write
         (vs "sensor" = read-only, or "actuator" = a single joint). -->
    <ros2_control name="RobotSystem" type="system">

        <!-- <hardware><plugin> points to the C++ class that actually implements
             this interface. In simulation it reads/writes joint values from/to
             Gazebo; on the real robot it talks to the Arduino over serial via
             diffbot_firmware/DiffbotInterface instead. -->
        <xacro:if value="$(arg is_sim)">
            <!-- ROS 2 Humble -->
            <xacro:if value="$(arg is_ignition)">
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>
            </xacro:if>

            <!-- ROS 2 Iron or above -->
            <xacro:unless value="$(arg is_ignition)">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>
        </xacro:if>

        <!-- Real robot: Arduino hardware interface (diffbot_firmware) -->
        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <plugin>diffbot_firmware/DiffbotInterface</plugin>
                <param name="port">/dev/ttyUSB0</param>
            </hardware>
        </xacro:unless>

        <!-- Per-joint interfaces exposed to controllers:
             - command_interface: what a controller is allowed to WRITE to
               command the joint (here, target velocity, clamped to [min, max]).
             - state_interface: what controllers/broadcasters can READ to know
               the joint's current value (here, position and velocity), fed by
               the hardware plugin above. -->
        <joint name="wheel_right_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="wheel_left_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

    </ros2_control>

</robot>